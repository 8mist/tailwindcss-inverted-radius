{
  "name": "tailwindcss-inverted-radius",
  "version": "1.0.0",
  "description": "Tailwind CSS v4 utilities for inverted (concave) rounded corners.",
  "keywords": [
    "border-radius",
    "concave",
    "corners",
    "css",
    "inverted-radius",
    "mask",
    "rounded",
    "tailwind",
    "tailwindcss",
    "tailwindcss-plugin",
    "utility"
  ],
  "homepage": "https://github.com/robertsargent/tailwindcss-inverted-radius#readme",
  "bugs": "https://github.com/robertsargent/tailwindcss-inverted-radius/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsargent/tailwindcss-inverted-radius.git"
  },
  "license": "MIT",
  "author": {
    "name": "Robert Sargent",
    "url": "https://github.com/robertsargent"
  },
  "type": "module",
  "exports": {
    ".": {
      "style": "./dist/tailwindcss-inverted-radius.css"
    }
  },
  "main": "./dist/tailwindcss-inverted-radius.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tailwindcss -i ./src/tailwindcss-inverted-radius.css -o ./dist/tailwindcss-inverted-radius.css -m",
    "dev": "tailwindcss -i ./src/tailwindcss-inverted-radius.css -o ./dist/tailwindcss-inverted-radius.css --watch",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
